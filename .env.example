# Copy to .env locally. Do not commit real values.
# Official docs: https://apidocs.nobitex.ir

# Optional override; default is https://apiv2.nobitex.ir
NOBITEX_BASE_URL=

# User-Agent is always TraderBot/<name>-<version>
NOBITEX_APP_NAME=MyBot
NOBITEX_APP_VERSION=1.0.0

# Token auth: sent as `Authorization: Token <value>`
NOBITEX_TOKEN=

# API-key auth (preferred for bots). Public key + URL-safe Base64 Ed25519 private key.
# API-key scopes (https://apidocs.nobitex.ir/api_key/api-key-guide):
#   READ  — list user orders (GET/POST /market/orders/list)
#   TRADE — place, close, or cancel orders (including POST /market/orders/update-status)
NOBITEX_API_KEY=
NOBITEX_API_SECRET=
